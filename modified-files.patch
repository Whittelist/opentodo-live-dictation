+/** A task a spoken correction can change: its title and its day. */
+type Spoken = { title: string; due: { date: string; time?: string } | null }
+
+/** What the local parser makes of a phrase: a new task, or the fields it changes on the last one. */
+type SpokenReading = { input: QuickAddInput } | { patch: { title?: string; due?: { date: string; time?: string } } }
+
+/**
+ * Spoken phrases as tasks. `read` is the local reading (voice-ramble-parity): the
+ * same parser as a typed line, and a phrase that corrects the last task ("no, a
+ * las tres y media y con Marcos") changes it instead of making another. The
+ * field dictation writes each reading at once (`onPhrase`). The live dictation
+ * (fork: voice-live) keeps drafts until the person adds them: `live` reads a
+ * phrase its interpreter could not, and saves the confirmed drafts with quick
+ * add's own add, as one batch with one Undo where quick add has one.
+ */
+function useSpokenTasks({ context, dismissed, logDone, labels, onAdd, onAddMany, onVoiceAdded }: {
+  context: () => Omit<ParseContext, 'dismissed'> | null
+  dismissed: Span[]
+  logDone: boolean
+  labels: readonly LabelRef[]
+  onAdd: (input: QuickAddInput) => Promise<string | void> | string | void
+  onAddMany?: (inputs: QuickAddInput[]) => Promise<void> | void
+  onVoiceAdded?: () => void
+}) {
+  const encrypted = useEncryption().enabled
+  // The task the voice session made last (or the last typed one), so a spoken correction edits it.
+  const lastTask = useRef<LastTask | null>(null)
+
+  async function read(text: string, last: Spoken | null): Promise<SpokenReading | null> {
+    const line = text.trim()
+    if (!line) return null
+    // The spoken-correction rules are loaded with the first phrase, not with the app.
+    const c = await import('../lib/voice/correction')
+    if (last && c.isCorrection(line)) {
+      const patch = correction(c, last, line)
+      return patch ? { patch } : null
+    }
+    // Without a task to correct, "no, …" is still not part of the title.
+    const said = c.normalizeSpokenClock(c.isCorrection(line) ? c.stripCorrection(line) : line)
+    const { parsed } = parseLine(said, context(), dismissed, logDone)
+    const fixed = parsed && parsed.due?.time ? { ...parsed, due: { ...parsed.due, time: c.shiftHour(parsed.due.time, said) } } : parsed
+    const input: QuickAddInput = fixed && fixed.title ? await toTaskInput(fixed, { labels, createLabel: createLabelByName }) : { title: line }
+    if (input.title) input.title = c.capitalize(input.title)
+    return { input }
+  }
+
+  /** A spoken correction of `last` as the fields it changes; null when it changes nothing. */
+  function correction(c: typeof import('../lib/voice/correction'), last: Spoken, line: string) {
+    const body = c.stripCorrection(c.normalizeSpokenClock(line))
+    if (!body) return null
+    const { parsed } = parseLine(body, context(), dismissed, logDone)
+    const patch: { title?: string; due?: { date: string; time?: string } } = {}
+    if (parsed?.due) {
+      const keepDate = last.due?.date && !c.mentionsDate(body)
+      const date = keepDate ? last.due!.date : parsed.due.date
+      const time = parsed.due.time ? c.shiftHour(parsed.due.time, body) : last.due?.time ?? parsed.due.time
+      patch.due = { date, ...(time ? { time } : {}) }
+    }
+    const title = c.capitalize(c.mergeTitle(last.title, parsed?.title ?? ''))
+    if (title && title !== last.title) patch.title = title
+    return patch.title || patch.due ? patch : null
+  }
+
+  /** The field dictation: a phrase is written at once, and a correction edits the last task. */
+  async function add(text: string, last: LastTask | null): Promise<void> {
+    const reading = await read(text, last)
+    if (!reading) return
+    if ('patch' in reading) {
+      if (!last) return
+      await updateTask(last.id, reading.patch)
+      lastTask.current = { ...last, title: reading.patch.title ?? last.title, due: reading.patch.due ?? last.due }
+      return
+    }
+    const created = await onAdd(reading.input)
+    if (typeof created === 'string') lastTask.current = { id: created, title: reading.input.title, due: reading.input.due ?? null }
+  }
+
+  const live: LiveDictationHost = {
+    addAll: async (inputs) => {
+      if (onAddMany) await onAddMany(inputs)
+      else for (const input of inputs) await onAdd(input)
+    },
+    fallback: (text, last) => read(text, last),
+    shareNames: () => !encrypted,
+    added: () => onVoiceAdded?.(),
+  }
+  return { live, lastTask, onPhrase: (text: string) => { void add(text, lastTask.current) } }
+}
