+// liveService is the connected service when it offers the live dictation; it
+// answers the refusal itself otherwise.
+func (s *Routes) liveService(w http.ResponseWriter, r *http.Request) (root, key string, ok bool) {
+	root, key, ok, err := s.STT.Live(r.Context())
+	if err != nil {
+		httpx.Internal(w, s.Log, err)
+		return "", "", false
+	}
+	if !ok {
+		httpx.WriteError(w, http.StatusConflict, "stt_not_configured", "live dictation needs OpenAI's API connected as the speech service")
+		return "", "", false
+	}
+	if !s.Allow(httpx.UserFrom(r.Context()).ID) {
+		httpx.WriteError(w, http.StatusTooManyRequests, "rate_limited", "too many phrases, wait a minute")
+		return "", "", false
+	}
+	return root, key, true
+}
+
+// handleLive relays the browser's WebRTC offer to OpenAI with the session and
+// the key, and answers OpenAI's description. The audio then goes from the
+// browser to OpenAI; this server never receives it.
+func (s *Routes) handleLive(w http.ResponseWriter, r *http.Request) {
+	var in struct {
+		SDP      string `json:"sdp"`
+		Language string `json:"language"`
+	}
+	if err := httpx.ReadJSONLimit(r, &in, voice.MaxOffer+1024); err != nil {
+		httpx.BadBody(w, err)
+		return
+	}
+	if !voice.ValidOffer(in.SDP) {
+		httpx.WriteError(w, http.StatusBadRequest, "invalid_input", "sdp: send the browser's WebRTC offer with audio")
+		return
+	}
+	if !sttLanguage.MatchString(in.Language) {
+		in.Language = ""
+	}
+	root, key, ok := s.liveService(w, r)
+	if !ok {
+		return
+	}
+	answer, err := voice.Connect(r.Context(), s.STT.Client(), root, key, in.SDP, voice.Session(voice.ConfigFrom(s.STT.LiveEnv()), in.Language))
+	switch {
+	case err == nil:
+		httpx.WriteJSON(w, http.StatusOK, map[string]any{"sdp": answer})
+	case errors.Is(err, stt.ErrUnavailable):
+		httpx.WriteError(w, http.StatusBadGateway, "stt_unavailable", err.Error())
+	default:
+		httpx.Internal(w, s.Log, err)
+	}
+}
+
+// handleInterpret turns one utterance of a live dictation into task
+// operations. The text and the session's tasks pass through memory only.
+func (s *Routes) handleInterpret(w http.ResponseWriter, r *http.Request) {
+	var in voice.Request
+	if err := httpx.ReadJSON(r, &in); err != nil {
+		httpx.BadBody(w, err)
+		return
+	}
+	if _, err := in.Validate(); err != nil {
+		httpx.WriteError(w, http.StatusBadRequest, "invalid_input", err.Error())
+		return
+	}
+	root, key, ok := s.liveService(w, r)
+	if !ok {
+		return
+	}
+	actions, err := voice.Interpret(r.Context(), s.STT.Client(), root, key, voice.ConfigFrom(s.STT.LiveEnv()), in)
+	var fe *voice.FieldError
+	switch {
+	case err == nil:
+		httpx.WriteJSON(w, http.StatusOK, map[string]any{"actions": actions})
+	case errors.As(err, &fe):
+		httpx.WriteError(w, http.StatusBadRequest, "invalid_input", fe.Error())
+	case errors.Is(err, stt.ErrUnavailable):
+		httpx.WriteError(w, http.StatusBadGateway, "stt_unavailable", err.Error())
+	default:
+		httpx.Internal(w, s.Log, err)
+	}
+}
