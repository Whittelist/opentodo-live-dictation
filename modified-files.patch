+func (s *Service) Live(ctx context.Context) (root, key string, ok bool, err error) {
+	if s.env.Live.Off {
+		return "", "", false, nil
+	}
+	r, err := s.resolve(ctx)
+	if err != nil {
+		return "", "", false, err
+	}
