+	if r.url == "" || r.key == "" || perr != nil || !s.liveHost(u.Host) {
+		return "", "", false, nil
+	}
+	return apiRoot(r.url), r.key, true, nil
+}
+
+func (s *Service) liveHost(host string) bool {
+	if host == LiveHost {
+		return true
+	}
+	for _, h := range s.liveHosts {
+		if h == host {
+			return true
+		}
+	}
+	return false
+}
+
+// apiRoot is a service URL without a trailing /v1: the transcription and the
+// live routes append their own /v1/… path, so "https://api.openai.com/v1" and
+// "https://api.openai.com" both work.
+func apiRoot(raw string) string {
+	return strings.TrimSuffix(strings.TrimRight(raw, "/"), "/v1")
+}
 
